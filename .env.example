# AI Writer Configuration (Gemma 4 / Gemini API via Google AI Studio)
GEMINI_API_KEY=
# Optional: Model override (defaults to gemini-3.8-flash / gemma-4-31b-it)
# GEMMA_MODEL=gemini-3.8-flash

# Jev Engine Configuration
# Mode: "simulated" (default) or "live"
JEV_MODE=simulated

# x402 Real Testnet Payment Configuration (Ethereum Sepolia)
X402_NETWORK=testnet
X402_FACILITATOR_URL=https://x402.org/facilitator

# Optional: Custom Sepolia RPC URL (has built-in public fallbacks)
# SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Optional: Tavily Search API key (defaults to free Google News RSS & Wikipedia scraper)
# TAVILY_API_KEY=
